# Release CI replaces every ${...} value, exports each source digest as an OCI
# image layout, and writes the rendered file as images.lock.yaml. The offline
# packer intentionally rejects this template because unresolved digests are not a lock.
apiVersion: migration.smartx.com/v1alpha1
kind: OfflineImageLock
bundleVersion: ${BUNDLE_VERSION}
images:
  - name: platform-api
    source: ${API_SOURCE}@sha256:${API_DIGEST}
    target: ${TARGET_PROJECT}/api:${BUNDLE_VERSION}
    platforms: [linux/amd64, linux/arm64]
    layoutPath: images/platform-api
    sbomPath: sbom/platform-api.spdx.json
    signaturePath: signatures/platform-api.bundle.json
    scanPath: scans/platform-api.json
  - name: platform-worker
    source: ${WORKER_SOURCE}@sha256:${WORKER_DIGEST}
    target: ${TARGET_PROJECT}/worker:${BUNDLE_VERSION}
